{
  "name": "circuit-mcp",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "A visual workflow builder that lives inside a Claude conversation and runs on the connectors you already have.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:app": "node scripts/build-app.mjs",
    "build": "node scripts/build-app.mjs && node scripts/build-output.mjs",
    "dev": "npm run build:app && tsx watch src/local.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector",
    "harness": "npm run build:app && node scripts/gen-fixtures.mjs && node scripts/build-harness.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-apps",
    "claude",
    "workflow",
    "automation",
    "connectors",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandononchain/circuit-mcp.git"
  }
}