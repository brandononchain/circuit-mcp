# --- required for the model steps -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- storage: leave blank to run fully in memory (dev only) -----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail / Calendar --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# must match the redirect URI registered in Google Cloud
PUBLIC_BASE_URL=http://localhost:8787

# --- access control ----------------------------------------------------------
# Any bearer token listed here (comma separated) may reach /mcp.
# Leave blank while developing locally; set it before you expose the server.
CIRCUIT_TOKENS=
