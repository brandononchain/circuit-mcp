# --- required for the model steps -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- storage: leave blank to run fully in memory (dev only) -----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail / Calendar --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# must match the redirect URI registered in Google Cloud
PUBLIC_BASE_URL=http://localhost:8787

# --- who is allowed in ------------------------------------------------------
# Set this and Circuit becomes an OAuth 2.1 server: clients register, you approve
# once in the browser with this key, and they get tokens. Leave it blank and the
# server runs open, which is fine locally and never fine on the internet.
CIRCUIT_OWNER_KEY=

# Signs registrations, codes and tokens. Falls back to a value derived from the
# owner key. Rotating this invalidates every token at once.
CIRCUIT_SECRET=

# Which workspace the owner key unlocks. One key, one workspace, for now.
CIRCUIT_WORKSPACE=owner

# Legacy bearer tokens, ignored once CIRCUIT_OWNER_KEY is set.
CIRCUIT_TOKENS=
