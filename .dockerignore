# The build runs `npm ci` and bundles from source inside the image. Anything
# generated on the host is either rebuilt or irrelevant, and copying it in
# invalidates the layer cache on every change.
node_modules
dist
.vercel
.git
.github

# Never let a local .env reach the image. Railway supplies its own variables.
.env
.env.*
!.env.example

# Generated by scripts/build-app.mjs during the image build.
src/app/board.html
src/app/board.generated.ts
scripts/harness.html
scripts/fixtures.json

# Docs and screenshots do not belong in a runtime image.
docs
examples
*.md
!README.md
*.png
